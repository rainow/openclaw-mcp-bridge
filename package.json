{
  "name": "openclaw-mcp-bridge",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenClaw as MCP: expose OpenClaw agents to any MCP-compatible agent",
  "license": "MIT",
  "keywords": ["mcp", "openclaw", "voice", "agent-bridge"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
